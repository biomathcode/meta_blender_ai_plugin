# Copy this file to ".env" (in this addon folder, next to your .blend,
# or point Addon Preferences > .env File at it) and paste your keys.
# Get a key at https://dev.meta.ai  (API Keys). Keys look like LLM|...|...
META_API_KEY=
# Accepted aliases (first found wins): MODEL_API_KEY, MUSE_API_KEY
#
# Modal — cloud camera rendering (https://modal.com/docs/examples/blender_video)
# Get tokens at https://modal.com/settings/tokens (or run: modal token new)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Or paste both in Edit > Preferences > Add-ons > Muse AI Texture.
# The Modal CLI is also required:  pip install modal
